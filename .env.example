# Copy to .env and fill in values from your Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chrome Web Store state: unavailable, review, or live
NEXT_PUBLIC_CHROME_STORE_STATUS=unavailable
# Paste the listing URL when Google provides it. The install CTA appears only when status is live.
NEXT_PUBLIC_CHROME_STORE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional extension cloud sync (run npm run sync:config)
# Uses NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY above
