# Copy to .env and fill in values from your Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# After Chrome Web Store approval, paste the listing URL (optional)
NEXT_PUBLIC_CHROME_STORE_URL=

# Optional extension cloud sync (run npm run sync:config)
# Uses NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY above
